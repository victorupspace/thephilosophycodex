# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source: "seed" (bundled demo/seed data) or "supabase"
DATA_SOURCE=seed

# Supabase (required when DATA_SOURCE=supabase or to enable the backoffice login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics transport: "none" | "console"
NEXT_PUBLIC_ANALYTICS=console
